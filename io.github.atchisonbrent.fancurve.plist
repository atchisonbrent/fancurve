<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.github.atchisonbrent.fancurve</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/libexec/fancurve/start</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>StandardOutPath</key>
    <string>/var/log/fancurve.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/fancurve.log</string>
</dict>
</plist>
